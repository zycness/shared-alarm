# API Configuration
PORT=3001
NODE_ENV=production

# Database
DATABASE_URL=./data/shared-alarm.db

# JWT - CHANGE THIS IN PRODUCTION (generate with: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=https://alarm.kevdevelopment.com

# Web Push (VAPID) - Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:kevinflores2322002@gmail.com

# Firebase Cloud Messaging (for mobile push notifications)
# Option A: Path to service account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option B: JSON content as string (for Dokploy/Docker - paste entire JSON here)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
